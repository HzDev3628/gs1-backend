{
  "name": "acme-data-room-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "supabase:login": "supabase login",
    "supabase:link": "supabase link",
    "migration:new": "supabase migration new",
    "schema:migration": "supabase db diff -f",
    "schema:verify": "supabase db reset",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "db:reset": "supabase db reset",
    "db:repair:initial": "supabase migration repair --status applied 20260817000000",
    "db:types": "supabase gen types typescript --linked --schema public"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@supabase/supabase-js": "^2.108.0",
    "dotenv": "^16.6.1",
    "hono": "^4.10.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^22.20.1",
    "supabase": "^2.114.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
